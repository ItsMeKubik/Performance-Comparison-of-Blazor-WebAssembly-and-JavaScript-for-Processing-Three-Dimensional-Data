<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>browser</SupportedOSPlatformVersion>
    <RunAOTCompilation>true</RunAOTCompilation>
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="EnsureDotnetJsAlias" AfterTargets="Publish">
    <ItemGroup>
        <_DotnetJs Include="$(PublishDir)wwwroot/_framework/dotnet.*.js"
            Exclude="$(PublishDir)wwwroot/_framework/dotnet.native.*.js;$(PublishDir)wwwroot/_framework/dotnet.runtime.*.js" />
    </ItemGroup>

    <Copy
        SourceFiles="@(_DotnetJs)"
        DestinationFiles="$(PublishDir)wwwroot/_framework/dotnet.js"
        SkipUnchangedFiles="true" />
  </Target>

</Project>
